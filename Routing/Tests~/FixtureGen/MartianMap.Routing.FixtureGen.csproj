<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Runs on the .NET 10 runtime too, so the same project works with SDK 9 or 10. -->
    <RollForward>Major</RollForward>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>MartianMap.Routing.FixtureGen</RootNamespace>
    <AssemblyName>MartianMap.Routing.FixtureGen</AssemblyName>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../MartianMap.Routing.csproj" />
  </ItemGroup>
</Project>
