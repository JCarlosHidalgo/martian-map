<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Runs on the .NET 10 runtime too, so the same project works with SDK 9 or 10. -->
    <RollForward>Major</RollForward>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>MartianMap.Routing.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MartianMap.Routing.csproj" />
    <ProjectReference Include="FixtureGen/MartianMap.Routing.FixtureGen.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- FixtureGen and BenchmarkRunner are their own projects. -->
    <Compile Remove="FixtureGen/**" />
    <None Remove="FixtureGen/**" />
    <Compile Remove="BenchmarkRunner/**" />
    <None Remove="BenchmarkRunner/**" />
  </ItemGroup>
</Project>
