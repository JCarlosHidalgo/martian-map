<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- The C# version Unity 6000.3 compiles. -->
    <LangVersion>9.0</LangVersion>
    <RootNamespace>MartianMap.Routing</RootNamespace>
    <AssemblyName>MartianMap.Routing</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The tests are a separate project; Unity skips Tests~/ because it ends in ~. -->
    <Compile Remove="Tests~/**" />
    <None Remove="Tests~/**" />
  </ItemGroup>
</Project>
