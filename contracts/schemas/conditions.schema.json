{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conditions.schema.json",
  "title": "conditions",
  "description": "C6 radiation conditions for one zone. The effective dose rate is value multiplied by factors active in [valid_from, valid_to).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_id", "t_utc", "t_valid_utc", "quantity",
    "value", "unit", "uncertainty", "basis", "modifiers"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+){2,}$(?![\\s\\S])"
    },
    "t_utc": {"$ref": "#/$defs/utc"},
    "sol": {"type": "integer", "minimum": 0},
    "t_valid_utc": {"$ref": "#/$defs/utc"},
    "quantity": {"const": "dose_rate"},
    "value": {"type": "number", "minimum": 0},
    "unit": {"const": "uGy/h"},
    "uncertainty": {"description": "Fractional uncertainty, from 0 to 1.", "type": "number", "minimum": 0, "maximum": 1},
    "basis": {"enum": ["measured", "modelled"]},
    "derived_from": {"type": "string", "minLength": 1},
    "modifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "factor", "valid_from", "valid_to"],
        "properties": {
          "donki_activity_id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "factor": {"type": "number", "exclusiveMinimum": 0},
          "valid_from": {"$ref": "#/$defs/utc"},
          "valid_to": {"$ref": "#/$defs/utc"}
        }
      }
    }
  },
  "$defs": {
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-[0-3][0-9]T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$(?![\\s\\S])"
    }
  }
}
